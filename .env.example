# Configure a real SMTP provider to deliver password-reset emails to inboxes.
# Copy these settings into .env and replace the example values.
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-smtp-password-or-app-password
DEFAULT_FROM_EMAIL=JobNest <your-email@example.com>
