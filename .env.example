# Django Settings
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=False

# Production Database (Render / Vercel / Neon / Supabase set DATABASE_URL or POSTGRES_URL)
DATABASE_URL=postgresql://username:password@hostname/dbname
POSTGRES_URL=postgresql://username:password@hostname/dbname

# Local Database (used when DATABASE_URL is not set)
DB_NAME=jobs
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Allowed Hosts & CSRF Origins (.vercel.app and onrender.com domains are auto-allowed)
# Custom domains can be added here as comma-separated values:
EXTRA_ALLOWED_HOSTS=
EXTRA_CSRF_ORIGINS=

# Email Configuration (Optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=JobNest <noreply@jobnest.com>
